# Copiar a backend/.env  ->  cp backend/env.example backend/.env
# (después renombrar este archivo mismo a backend/.env.example, ver
# README.md)
#
# Dos roles en desarrollo local:
#   1. Config de la app (uvicorn/venv nativo, sin Docker) -- lo que lee
#      app/core/config.py vía load_dotenv(".env") cuando no hay
#      /run/secrets/remitos_env.
#   2. Docker Secret local para Postgres/MinIO: docker-compose.override.yml
#      monta ESTE mismo archivo como remitos_env cuando corrés
#      `docker compose up -d postgres minio` (mismo wrapper que en
#      producción, ver AGENTS.md / docker/postgres/, docker/minio/) -- por
#      eso las líneas POSTGRES_*/MINIO_ROOT_* de más abajo, aunque el
#      backend en sí no las use directamente.
#
# En producción no existe este archivo: remitos_env es un Docker Secret
# real, creado a mano en Portainer (contenido completo en README.md).

APP_ENV=development

DATABASE_URL=postgresql+asyncpg://remitos:remitos-local-dev@localhost:5432/remitos

# --- MinIO (cliente S3 del backend) ---------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin-local-dev
MINIO_BUCKET=remitos
MINIO_SECURE=false
MINIO_PRESIGNED_EXPIRES_SECONDS=900

# --- Gemini / OCR --------------------------------------------------------
GEMINI_API_KEY=
OCR_MODEL=models/gemini-3.5-flash-lite
OCR_TIMEOUT_SECONDS=120
OCR_MAX_RETRIES=3

# --- Imagen --------------------------------------------------------------
TARGET_IMAGE_SIZE_KB=300
IMAGE_MAX_WIDTH=2200
IMAGE_MAX_HEIGHT=2200
IMAGE_START_QUALITY=88
IMAGE_MIN_QUALITY=55

# --- Uploads y procesamiento ---------------------------------------------
MAX_UPLOAD_MB=25
PROCESSING_BATCH_SIZE=3
MAX_CONCURRENT_OCR=3

# --- Autenticacion (Google OAuth + sesion JWT propia) --------------------
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
JWT_SECRET_KEY=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_MINUTES=10080
# Vacio = cualquier cuenta Google verificada puede entrar.
ALLOWED_GOOGLE_EMAILS=
SESSION_COOKIE_NAME=remitos_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Postgres/MinIO nativos (solo los usa el wrapper del contenedor,
# ver arriba -- deben coincidir con DATABASE_URL / MINIO_ACCESS_KEY /
# MINIO_SECRET_KEY de más arriba) ------------------------------------------
POSTGRES_USER=remitos
POSTGRES_PASSWORD=remitos-local-dev
POSTGRES_DB=remitos
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-local-dev
