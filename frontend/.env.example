# Client ID de la app OAuth de Google (Web application).
# Es un valor publico: se embebe en el bundle en tiempo de build.
# Los origenes autorizados deben incluir el dominio donde se sirve el frontend.
VITE_GOOGLE_CLIENT_ID=REEMPLAZAR.apps.googleusercontent.com

# Base de la API. Dejar relativo en Docker: nginx proxea /api -> backend:8000.
VITE_API_URL=/api/v1
